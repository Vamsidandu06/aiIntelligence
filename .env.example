# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional - falls back to embedded local storage if omitted)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/interviewiq?retryWrites=true&w=majority

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
